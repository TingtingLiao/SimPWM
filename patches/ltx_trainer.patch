+class _SyncBucketBatchSampler:
+    """Batches for length-bucketed data (SIMPWM_BUCKET_MAP: a dataset.jsonl whose rows give the "bucket" of each "video";
+    the latent file videos/<stem>.pt belongs to the row with video videos/<stem>.mp4).
+
+    Each epoch: per bucket, a seeded shuffle cut into groups of world_size batches; the groups are shuffled and
+    concatenated. accelerate shards a batch sampler round-robin (batch k -> rank k mod world_size), so all ranks draw
+    the same bucket at every step and no rank waits on a longer clip. Identical on every rank (same seed and epoch).
+    """
+
+    def __init__(self, dataset, bucket_map: str, world: int, batch_size: int, seed: int) -> None:
+        rows = [json.loads(line) for line in open(bucket_map)]
+        by_stem = {Path(r["video"]).stem: r["bucket"] for r in rows if r.get("video")}
+        files = dataset.sample_files[next(iter(dataset.sample_files))]
+        self.groups = defaultdict(list)
+        for i, f in enumerate(files):
+            self.groups[by_stem.get(Path(f).stem)].append(i)
+        self.world, self.bs, self.seed, self.epoch = world, batch_size, seed, 0
+        logger.info(f"bucket-synchronised sampler: {({k: len(v) for k, v in self.groups.items()})}, world {world}")
+
+    def _batches(self, epoch: int) -> list[list[int]]:
+        rng = random.Random(self.seed + epoch)
+        units = []
+        for _, idx in sorted(self.groups.items(), key=lambda kv: str(kv[0])):
+            idx = idx[:]
+            rng.shuffle(idx)
+            batches = [idx[k : k + self.bs] for k in range(0, len(idx) - self.bs + 1, self.bs)]
+            units += [batches[k : k + self.world] for k in range(0, len(batches) - self.world + 1, self.world)]
+        rng.shuffle(units)
+        return [b for u in units for b in u]
+
+    def __iter__(self) -> Iterator[list[int]]:
+        batches = self._batches(self.epoch)
+        self.epoch += 1
+        return iter(batches)
+
+    def __len__(self) -> int:
+        return len(self._batches(self.epoch))
